# P2P 聊天系统 Nginx 配置文件
# 
# 使用说明:
# - Windows: 复制到 C:\nginx\conf\nginx.conf
# - Linux: 复制到 /etc/nginx/sites-available/p2p-chat
#
# 验证: nginx -t
# 启动: nginx / systemctl start nginx
# 重启: nginx -s reload / systemctl restart nginx

user www-data;
worker_processes auto;
error_log /var/log/nginx/error.log warn;
pid /var/run/nginx.pid;

events {
    worker_connections 2048;
    use epoll;  # Linux 性能优化
}

http {
    include /etc/nginx/mime.types;
    default_type application/octet-stream;

    # ========== 日志配置 ==========
    log_format main '$remote_addr - $remote_user [$time_local] "$request" '
                    '$status $body_bytes_sent "$http_referer" '
                    '"$http_user_agent" "$http_x_forwarded_for"';

    log_format p2p_chat '$remote_addr - [$time_local] "$request" '
                        '$status $body_bytes_sent '
                        '"$http_upgrade" "$connection"';

    access_log /var/log/nginx/access.log main;

    # ========== 性能优化 ==========
    sendfile on;
    tcp_nopush on;
    tcp_nodelay on;
    keepalive_timeout 65;
    types_hash_max_size 2048;
    
    # 上传文件大小限制
    client_max_body_size 20M;
    
    # 连接超时
    client_body_timeout 12;
    client_header_timeout 12;
    send_timeout 10;

    # ========== Gzip 压缩 ==========
    gzip on;
    gzip_vary on;
    gzip_proxied any;
    gzip_comp_level 6;
    gzip_types text/plain text/css text/xml text/javascript 
               application/json application/javascript 
               application/xml+rss application/rss+xml;

    # ========== 上游服务器配置 ==========
    upstream backend {
        server 127.0.0.1:3000 max_fails=3 fail_timeout=30s;
        
        # 可选: 添加多个后端实例进行负载均衡
        # server 127.0.0.1:3001 max_fails=3 fail_timeout=30s;
        # server 127.0.0.1:3002 max_fails=3 fail_timeout=30s;
        
        # 保持连接
        keepalive 32;
        keepalive_requests 100;
    }

    # ========== HTTP 服务器 ==========
    server {
        listen 80 default_server;
        listen [::]:80 default_server ipv6only=on;
        
        server_name _;
        
        access_log /var/log/nginx/p2p_chat_access.log p2p_chat;
        error_log /var/log/nginx/p2p_chat_error.log warn;

        # ===== 根路径 - 自动路由 =====
        location / {
            proxy_pass http://backend;
            proxy_http_version 1.1;
            
            # 保持连接
            proxy_set_header Connection "";
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
            
            # 超时设置
            proxy_connect_timeout 60s;
            proxy_send_timeout 60s;
            proxy_read_timeout 60s;
            
            # 缓冲
            proxy_buffering on;
            proxy_buffer_size 4k;
            proxy_buffers 8 4k;
        }

        # ===== REST API 路由 =====
        location /api/ {
            proxy_pass http://backend;
            proxy_http_version 1.1;
            
            proxy_set_header Connection "";
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
            
            # API 超时
            proxy_connect_timeout 30s;
            proxy_send_timeout 30s;
            proxy_read_timeout 30s;
            
            # 缓存（可选）
            proxy_cache_bypass $http_cache_control;
        }

        # ===== WebSocket 路由 =====
        location /ws {
            proxy_pass http://backend;
            
            # WebSocket 协议升级
            proxy_http_version 1.1;
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection "upgrade";
            
            # 代理头
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
            
            # WebSocket 超时（长连接）
            proxy_read_timeout 86400s;
            proxy_send_timeout 86400s;
            proxy_connect_timeout 7d;
            
            # 禁用缓冲以支持双向通信
            proxy_buffering off;
            
            # 关闭超时响应
            proxy_cache_bypass $http_upgrade;
        }

        # ===== 健康检查 =====
        location /health {
            access_log off;
            default_type application/json;
            return 200 '{"status":"ok","server":"nginx","timestamp":$server_time}';
        }

        # ===== Nginx 状态页 =====
        location /nginx_status {
            stub_status on;
            access_log off;
            allow 127.0.0.1;
            allow 192.168.0.0/16;  # 允许内网访问
            deny all;
        }

        # ===== 错误页面 =====
        error_page 404 /404.html;
        location = /404.html {
            default_type application/json;
            return 404 '{"error":"Not Found","code":404}';
        }

        error_page 500 502 503 504 /50x.html;
        location = /50x.html {
            default_type application/json;
            return 500 '{"error":"Server Error","code":500}';
        }

        # ===== 拒绝不良请求 =====
        location ~ /\.ht {
            deny all;
        }
    }

    # ========== HTTPS 服务器 (可选) ==========
    # 取消注释以启用 HTTPS
    #
    # server {
    #     listen 443 ssl http2;
    #     listen [::]:443 ssl http2 ipv6only=on;
    #     
    #     server_name your-domain.com;
    #     
    #     # SSL 证书配置
    #     ssl_certificate /etc/letsencrypt/live/your-domain.com/fullchain.pem;
    #     ssl_certificate_key /etc/letsencrypt/live/your-domain.com/privkey.pem;
    #     
    #     # SSL 配置
    #     ssl_protocols TLSv1.2 TLSv1.3;
    #     ssl_ciphers HIGH:!aNULL:!MD5;
    #     ssl_prefer_server_ciphers on;
    #     ssl_session_cache shared:SSL:10m;
    #     ssl_session_timeout 10m;
    #     
    #     # HSTS (可选)
    #     add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    #     
    #     # ... 其他位置配置与 HTTP 相同
    # }
    #
    # # HTTP 重定向到 HTTPS
    # server {
    #     listen 80;
    #     listen [::]:80;
    #     server_name your-domain.com;
    #     return 301 https://$host$request_uri;
    # }
}
